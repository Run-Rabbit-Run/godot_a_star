[sub_resource type="Resource" id="Core"]
script = ExtResource("dependency")
package_id = &"core"
exact_version = "1.0.0"

[sub_resource type="Resource" id="Manifest"]
script = ExtResource("manifest")
package_id = &"plateau"
dependencies = Array[ExtResource("dependency")]([SubResource("Core")])
entry_battle_ids = Array[StringName]([&"plateau:battle"])

[resource]
script = ExtResource("package")
manifest = SubResource("Manifest")
battles = Array[ExtResource("battle")]([ExtResource("battle_data")])
maps = Array[ExtResource("map")]([ExtResource("map_data")])
units = Array[ExtResource("unit")]([ExtResource("sorokin"), ExtResource("ranger"), ExtResource("bastion"), ExtResource("guide"), ExtResource("carapace"), ExtResource("reaper"), ExtResource("spore"), ExtResource("sentry")])
unit_presentations = Array[ExtResource("presentation")]([ExtResource("sorokin_actor"), ExtResource("ranger_actor"), ExtResource("bastion_actor"), ExtResource("guide_actor"), ExtResource("carapace_actor"), ExtResource("reaper_actor"), ExtResource("spore_actor"), ExtResource("sentry_actor")])
