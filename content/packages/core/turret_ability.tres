[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://bjk5588fyovmm"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="summon"]
script = ExtResource("effect")
effect_type_id = &"core:summon"
parameters = {
"center_only": true,
"unit_id": "core:turret_unit"
}

[resource]
script = ExtResource("ability")
id = &"core:turret"
display_name = "Турель"
description = "Призывает «{summon}» на свободный гекс на дальности {range}: ОЗ {summon_hp}, атака {summon_damage} на дальность {summon_range}. Перезарядка {cooldown}."
presentation_id = &"core:turret_ability_presentation"
range = 4
effects = Array[ExtResource("effect")]([SubResource("summon")])
target_mode = 3
cooldown_turns = 3
