[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://cair5883mstge"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="positioning"]
script = ExtResource("effect")
effect_type_id = &"core:positioning"
parameters = {
"operation": "shot_pull"
}

[resource]
script = ExtResource("ability")
id = &"core:attracting_shot"
display_name = "Притягивающий выстрел"
description = "Наносит выбранному врагу базовый урон и притягивает остальных юнитов в радиусе {radius} к цели на 1 гекс. Перезарядка {cooldown}."
area_radius = 2
effects = Array[ExtResource("effect")]([SubResource("positioning")])
target_mode = 1
uses_attack_range = true
cooldown_turns = 2
