[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="positioning"]
script = ExtResource("effect")
effect_type_id = &"core:positioning"
parameters = {"operation": "intercept"}

[resource]
script = ExtResource("ability")
id = &"core:intercept"
presentation_id = &"core:shove_presentation"
display_name = "Перехват"
description = "До следующего хода бьёт вплотную первого врага, вошедшего на соседний гекс. Перезарядка {cooldown}."
range = 1
area_radius = 0
target_mode = 6
cooldown_turns = 2
effects = Array[ExtResource("effect")]([SubResource("positioning")])
