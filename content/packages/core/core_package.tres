[gd_resource type="Resource" script_class="ContentPackage" load_steps=13 format=3]

[ext_resource type="Script" path="res://features/content/content_package.gd" id="1_package"]
[ext_resource type="Script" path="res://features/content/content_package_manifest.gd" id="2_manifest"]
[ext_resource type="Script" path="res://features/battle/definitions/battle_definition.gd" id="3_battle_type"]
[ext_resource type="Resource" path="res://features/battle/definitions/debug_battle.tres" id="4_battle"]
[ext_resource type="Script" path="res://features/battle/map/battle_map_definition.gd" id="5_map_type"]
[ext_resource type="Resource" path="res://features/battle/map/definitions/debug_battle_map.tres" id="6_map"]
[ext_resource type="Script" path="res://features/battle/units/unit_definition.gd" id="7_unit_type"]
[ext_resource type="Resource" path="res://features/battle/units/definitions/debug_player.tres" id="8_player"]
[ext_resource type="Resource" path="res://features/battle/units/definitions/debug_enemy.tres" id="9_enemy"]
[ext_resource type="Script" path="res://features/battle/definitions/ai_profile_definition.gd" id="10_ai_type"]
