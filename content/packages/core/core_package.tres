[sub_resource type="Resource" id="Manifest_core"]
script = ExtResource("2_manifest")
package_id = &"core"
package_version = "1.0.0"
entry_battle_ids = Array[StringName]([&"core:debug_battle"])

[resource]
script = ExtResource("1_package")
manifest = SubResource("Manifest_core")
battles = Array[ExtResource("3_battle_type")]([ExtResource("4_battle")])
maps = Array[ExtResource("5_map_type")]([ExtResource("6_map")])
units = Array[ExtResource("7_unit_type")]([ExtResource("8_player"), ExtResource("9_enemy"), ExtResource("12_player_ranged"), ExtResource("13_enemy_ranged")])
ai_profiles = Array[ExtResource("10_ai_type")]([ExtResource("11_ai")])
