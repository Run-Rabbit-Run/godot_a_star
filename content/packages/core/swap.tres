[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://moeuw3wid7l4"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="positioning"]
script = ExtResource("effect")
effect_type_id = &"core:positioning"
parameters = {
"operation": "swap"
}

[resource]
script = ExtResource("ability")
id = &"core:swap"
display_name = "Обмен местами"
description = "Меняет бойца местами с выбранным юнитом на дальности {range}. Перезарядка {cooldown}."
presentation_id = &"core:shove_presentation"
