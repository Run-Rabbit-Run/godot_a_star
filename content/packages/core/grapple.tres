[sub_resource type="Resource" id="positioning"]
script = ExtResource("effect")
effect_type_id = &"core:positioning"
parameters = {
"operation": "grapple"
}

[resource]
script = ExtResource("ability")
id = &"core:grapple"
display_name = "Гарпун"
description = "Подтягивает бойца к выбранному юниту на дальности {range}. Боец останавливается перед целью или преградой. Перезарядка {cooldown}."
