[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="damage"]
script = ExtResource("effect")
effect_type_id = &"core:damage"
parameters = {"amount": 1, "secondary_amount": 1, "damage_type": "fire", "affects_obstacles": true}

[sub_resource type="Resource" id="burning"]
script = ExtResource("effect")
effect_type_id = &"core:unit_status"
parameters = {"status_id": "core:burning", "levels": 1}

[resource]
script = ExtResource("ability")
id = &"core:fire_stroke"
display_name = "Огненный росчерк"
description = "Росчерк по выбранной стороне: каждый юнит на трёх соседних гексах — союзник тоже — получает {damage} урона ({damage_type}) и {status} ×{levels}. Препятствия на этих гексах тоже получают {damage} урона. Перезарядка {cooldown}."
presentation_id = &"core:fire_stroke_presentation"
range = 1
area_radius = 0
target_mode = 8
cooldown_turns = 1
melee_attack = false
returns_next_turn = false
effects = Array[ExtResource("effect")]([SubResource("damage"), SubResource("burning")])
