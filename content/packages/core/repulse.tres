[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://clc1tqgtcmdx6"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="push"]
script = ExtResource("effect")
effect_type_id = &"core:push"
parameters = {
"distance": 1
}

[resource]
script = ExtResource("ability")
id = &"core:repulse"
display_name = "Отталкивание"
description = "Сдвигает всех соседних юнитов на {push_distance} гекс от бойца. Перезарядка {cooldown}."
presentation_id = &"core:shove_presentation"
area_radius = 1
effects = Array[ExtResource("effect")]([SubResource("push")])
target_mode = 6
cooldown_turns = 2
