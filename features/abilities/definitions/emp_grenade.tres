[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://bt4gx425kp2k7"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="effect_2"]
script = ExtResource("effect")
effect_type_id = &"core:hex_state"
parameters = {
"center_only": true,
"state_id": "core:electricity"
}

[sub_resource type="Resource" id="effect_0"]
script = ExtResource("effect")
effect_type_id = &"core:damage"
parameters = {
"amount": 3,
"damage_type": "electric"
}

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("effect")
effect_type_id = &"core:unit_status"
parameters = {
"levels": 2,
"status_id": "core:electrified"
}

[resource]
script = ExtResource("ability")
id = &"core:emp_grenade"
display_name = "ЭМИ граната"
description = "Граната на дальность {range}: в центре возникает «{hex_state}», все в радиусе {radius} получают {damage} урона ({damage_type}) и {status} ×{levels}, включая союзников."
presentation_id = &"core:electric_ability_actor"
range = 3
area_radius = 1
effects = Array[ExtResource("effect")]([SubResource("effect_2"), SubResource("effect_0"), SubResource("effect_1")])
target_mode = 2
