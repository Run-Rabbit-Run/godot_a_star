[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://bjlgcw6qpc4jb"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="damage"]
script = ExtResource("effect")
effect_type_id = &"core:damage"
parameters = {
"affects_obstacles": false,
"amount": 3,
"damage_type": "physical",
"use_base_attack": false
}

[resource]
script = ExtResource("ability")
id = &"core:spear_throw"
display_name = "Бросок копья"
description = "Бросок копья на дальность {range}: {damage} урона ({damage_type}) всем на пути, включая союзников. В начале следующего хода копьё возвращается и снова бьёт всех на пути."
presentation_id = &"core:spear_throw_presentation"
range = 4
effects = Array[ExtResource("effect")]([SubResource("damage")])
returns_next_turn = true
target_mode = 5
