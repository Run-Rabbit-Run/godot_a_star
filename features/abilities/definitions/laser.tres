[gd_resource type="Resource" script_class="AbilityDefinition" format=3 uid="uid://b5ira1sn44jbv"]

[ext_resource type="Script" uid="uid://e6ht8605r23q" path="res://features/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" uid="uid://dspmgv47bej7p" path="res://features/abilities/ability_effect_definition.gd" id="effect"]

[sub_resource type="Resource" id="effect_0"]
script = ExtResource("effect")
effect_type_id = &"core:damage"
parameters = {
"amount": 3,
"damage_type": "electric"
}

[sub_resource type="Resource" id="effect_1"]
script = ExtResource("effect")
effect_type_id = &"core:unit_status"
parameters = {
"levels": 2,
"status_id": "core:electrified"
}

[resource]
script = ExtResource("ability")
id = &"core:laser"
display_name = "Лазер"
description = "Луч вдоль прямой до края поля: {damage} урона ({damage_type}) и {status} ×{levels} всем на линии, включая союзников. Перезарядка {cooldown}."
presentation_id = &"core:laser_presentation"
range = 20
effects = Array[ExtResource("effect")]([SubResource("effect_0"), SubResource("effect_1")])
target_mode = 4
cooldown_turns = 2
