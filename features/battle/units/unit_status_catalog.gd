class_name UnitStatusCatalog
extends RefCounted

const RULES := {
	&"core:wet": {"name": "Влага", "description": "В конце своего хода теряет 1 уровень. Поглощает огненный урон: 1 урона за уровень, расходуя влагу. Усиливает электрический урон на число уровней без расхода. Влага и горение взаимно снимаются 1:1. Плазма запрещает влагу."},
	&"core:burning": {"name": "Горение", "description": "В конце своего хода наносит 1 огненного урона за уровень, затем теряет 1 уровень. Поглощает водный урон, расходуя 1 уровень за 1 урона. Взаимно снимается с влагой 1:1. При наличии масла вызывает взрыв."},
	&"core:acid": {"name": "Кислота", "description": "В конце своего хода снимает 1 уровень брони и теряет 1 уровень кислоты. При 5 и более уровнях сразу снимает всю броню и кислоту."},
	&"core:electrified": {"name": "Наэлектризованность", "description": "В конце своего хода наносит 1 электрического урона за уровень, затем теряет 1 уровень. Наложение, дающее 5 и более уровней, добавляет 1 уровень паралича."},
	&"core:paralysis": {"name": "Паралич", "description": "Пропускает свой ход. В конце пропущенного хода теряет 1 уровень."},
	&"core:plasma": {"name": "Плазма", "description": "В конце своего хода наносит 2 плазменного урона за уровень, затем теряет 1 уровень. Даёт неуязвимость к водному урону, снимает всю влагу и запрещает её наложение. Наложение, дающее 5 и более уровней, добавляет 1 уровень паралича."},
	&"core:sticky_oil": {"name": "Тягучее масло", "description": "Снижает передвижение на 1; при 5 уровнях — на 2. В конце своего хода теряет 1 уровень. Огненный урон или наложение горения вызывает взрыв с уроном, равным сумме уровней масла и горения. Взрыв наносит физический урон только этому юниту, расходует всё масло и сохраняет горение."},
	&"core:armor": {"name": "Броня", "description": "Каждый уровень блокирует 1 физического урона. Сама по себе не спадает. Кислота разрушает броню."},
}

static func has_status(id: StringName) -> bool:
	return RULES.has(id)

static func display_name(id: StringName) -> String:
	return String(RULES.get(id, {}).get("name", id))

static func description(id: StringName) -> String:
	return String(RULES.get(id, {}).get("description", ""))

static func movement_penalty(statuses: Dictionary) -> int:
	var oil := int(statuses.get(&"core:sticky_oil", 0))
	return 2 if oil >= 5 else (1 if oil > 0 else 0)
